(export (version "E")
  (design
    (source "npn_switch.kicad_sch")
    (date "2026-10-12")
    (tool "Eeschema 8.0 (hand-written example)"))
  (components
    (comp (ref "C1") (value "100n")
      (fields (field (name "Footprint")) (field (name "Datasheet")))
      (libsource (lib "Device") (part "C") (description "Unpolarized capacitor")))
    (comp (ref "Q1") (value "QNPN")
      (fields (field (name "Sim.Device") "NPN") (field (name "Sim.Name") "QNPN"))
      (libsource (lib "Device") (part "Q_NPN_BCE") (description "NPN transistor, base/collector/emitter")))
    (comp (ref "R1") (value "10k")
      (libsource (lib "Device") (part "R") (description "Resistor")))
    (comp (ref "R2") (value "1k")
      (libsource (lib "Device") (part "R") (description "Resistor")))
    (comp (ref "V1") (value "VPULSE")
      (fields (field (name "Sim.Device") "V") (field (name "Sim.Type") "PULSE")
              (field (name "Sim.Pins") "1=+ 2=-")
              (field (name "Sim.Params") "y1=0 y2=5 td=0 tr=10n tf=10n tw=0.5m per=1m"))
      (libsource (lib "Simulation_SPICE") (part "VPULSE") (description "Voltage source, pulse")))
    (comp (ref "V2") (value "12")
      (fields (field (name "Sim.Device") "V") (field (name "Sim.Type") "DC")
              (field (name "Sim.Pins") "1=+ 2=-") (field (name "Sim.Params") "dc=12"))
      (libsource (lib "Simulation_SPICE") (part "VDC") (description "Voltage source, DC")))
    (comp (ref "J1") (value "Conn_01x02")
      (libsource (lib "Connector") (part "Conn_01x02") (description "Generic connector (no SPICE model)"))))
  (libparts
    (libpart (lib "Device") (part "Q_NPN_BCE")
      (pins (pin (num "1") (name "B") (type "input")) (pin (num "2") (name "C") (type "passive")) (pin (num "3") (name "E") (type "passive")))))
  (nets
    (net (code "1") (name "GND")
      (node (ref "C1") (pin "2") (pintype "passive")) (node (ref "Q1") (pin "3") (pinfunction "E") (pintype "passive"))
      (node (ref "V1") (pin "2") (pintype "passive")) (node (ref "V2") (pin "2") (pintype "passive"))
      (node (ref "J1") (pin "2") (pinfunction "Pin_2") (pintype "passive")))
    (net (code "2") (name "/in")
      (node (ref "V1") (pin "1") (pintype "passive")) (node (ref "R1") (pin "1") (pintype "passive")))
    (net (code "3") (name "/base")
      (node (ref "R1") (pin "2") (pintype "passive")) (node (ref "Q1") (pin "1") (pinfunction "B") (pintype "input")))
    (net (code "4") (name "/vcc")
      (node (ref "V2") (pin "1") (pintype "passive")) (node (ref "R2") (pin "1") (pintype "passive")))
    (net (code "5") (name "/col")
      (node (ref "R2") (pin "2") (pintype "passive")) (node (ref "C1") (pin "1") (pintype "passive"))
      (node (ref "Q1") (pin "2") (pinfunction "C") (pintype "passive"))
      (node (ref "J1") (pin "1") (pinfunction "Pin_1") (pintype "passive")))))
