      (node (ref "V3") (pin "3") (pinfunction "S")) (node (ref "RV1") (pin "3") (pinfunction "3"))
      (node (ref "D1") (pin "4") (pinfunction "GND1")) (node (ref "D1") (pin "5") (pinfunction "GND2"))
      (node (ref "U9") (pin "2")) (node (ref "X1") (pin "2")))
    (net (code "2") (name "/raw") (node (ref "G1") (pin "1")) (node (ref "F1") (pin "1")))
    (net (code "3") (name "/vcc")
      (node (ref "F1") (pin "2")) (node (ref "R1") (pin "1")) (node (ref "V2") (pin "3") (pinfunction "E"))
      (node (ref "V3") (pin "1") (pinfunction "G")) (node (ref "R5") (pin "1")) (node (ref "RV1") (pin "1") (pinfunction "1"))
      (node (ref "D1") (pin "1") (pinfunction "VDD1")) (node (ref "D1") (pin "8") (pinfunction "VDD2")) (node (ref "U9") (pin "1"))
      (node (ref "X1") (pin "1")))
    (net (code "4") (name "/a") (node (ref "R1") (pin "2")) (node (ref "V1") (pin "2") (pinfunction "A")))
