    (net (code "6") (name "/b") (node (ref "V2") (pin "1") (pinfunction "B")) (node (ref "R3") (pin "1")))
    (net (code "7") (name "/c") (node (ref "V2") (pin "2") (pinfunction "C")) (node (ref "R4") (pin "1")))
    (net (code "8") (name "/d") (node (ref "V3") (pin "2") (pinfunction "D")) (node (ref "R5") (pin "2")))
    (net (code "9") (name "/w") (node (ref "RV1") (pin "2") (pinfunction "W")) (node (ref "D1") (pin "2") (pinfunction "VOA")))
    (net (code "10") (name "unconnected-(D1-VIB-Pad3)") (node (ref "D1") (pin "3") (pinfunction "VIB") (pintype "input+no_connect")))))
