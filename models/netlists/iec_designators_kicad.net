(export (version "E")
  (design
    (source "iec_designators.kicad_sch")
    (date "2026-10-12")
    (tool "Eeschema 8.0 (hand-written regression example: IEC/DIN reference designators)"))
  (components
    (comp (ref "G1") (value "12")
      (fields (field (name "Sim.Device") "V") (field (name "Sim.Type") "DC") (field (name "Sim.Pins") "1=+ 2=-") (field (name "Sim.Params") "dc=12"))
      (libsource (lib "Simulation_SPICE") (part "VDC") (description "Voltage source, DC")))
    (comp (ref "F1") (value "PTC 0.2A")
      (libsource (lib "Device") (part "Polyfuse") (description "Resettable fuse")))
    (comp (ref "R1") (value "1k") (libsource (lib "Device") (part "R") (description "Resistor")))
    (comp (ref "R2") (value "1k") (libsource (lib "Device") (part "R") (description "Resistor")))
    (comp (ref "V1") (value "BAT54")
      (libsource (lib "Device") (part "D_Schottky") (description "Schottky diode (IEC: V = semiconductor)")))
    (comp (ref "V2") (value "BC857")
      (libsource (lib "Device") (part "Q_PNP_BCE") (description "PNP transistor (IEC ref V)")))
    (comp (ref "R3") (value "10k") (libsource (lib "Device") (part "R") (description "Resistor")))
    (comp (ref "R4") (value "1k") (libsource (lib "Device") (part "R") (description "Resistor")))
    (comp (ref "V3") (value "2N7002")
      (libsource (lib "Device") (part "Q_NMOS_GDS") (description "N-MOSFET, 3 pins (IEC ref V)")))
    (comp (ref "R5") (value "1k") (libsource (lib "Device") (part "R") (description "Resistor")))
    (comp (ref "RV1") (value "10k") (libsource (lib "Device") (part "R_Potentiometer") (description "Potentiometer")))
    (comp (ref "D1") (value "ADuM1201")
      (libsource (lib "Isolator") (part "ADuM1201") (description "Digital isolator (IEC: D = integrated circuit)")))
    (comp (ref "U9") (value "FOO123")
      (libsource (lib "MyLib") (part "FOO123") (description "unknown part, no model")))
    (comp (ref "X1") (value "Screw_Terminal_01x02")
      (libsource (lib "Connector") (part "Screw_Terminal_01x02") (description "terminal (IEC: X = terminal)"))))
  (libparts
    (libpart (lib "Device") (part "D_Schottky")
      (pins (pin (num "1") (name "K") (type "passive")) (pin (num "2") (name "A") (type "passive"))))
    (libpart (lib "Device") (part "Q_PNP_BCE")
      (pins (pin (num "1") (name "B") (type "input")) (pin (num "2") (name "C") (type "passive")) (pin (num "3") (name "E") (type "passive"))))
    (libpart (lib "Device") (part "Q_NMOS_GDS")
      (pins (pin (num "1") (name "G") (type "input")) (pin (num "2") (name "D") (type "passive")) (pin (num "3") (name "S") (type "passive"))))
    (libpart (lib "Device") (part "R_Potentiometer")
      (pins (pin (num "1") (name "1") (type "passive")) (pin (num "2") (name "W") (type "passive")) (pin (num "3") (name "3") (type "passive"))))
    (libpart (lib "Isolator") (part "ADuM1201")
      (pins (pin (num "1") (name "VDD1")) (pin (num "2") (name "VOA")) (pin (num "3") (name "VIB")) (pin (num "4") (name "GND1"))
            (pin (num "5") (name "GND2")) (pin (num "6") (name "VIA")) (pin (num "7") (name "VOB")) (pin (num "8") (name "VDD2")))))
  (nets
    (net (code "1") (name "GND")
